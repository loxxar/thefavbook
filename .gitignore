# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Documentation d'agent installée par la CLI Prisma (~22k lignes de docs
# éditeur). Réinstallable depuis skills-lock.json, qui reste versionné.
/.agents/skills/
/.claude/skills/
/.windsurf/skills/

# Fichiers d'outillage de développement, propres à chaque poste.
/.claude/
/.agents/
/.windsurf/
/AGENTS.md
/CLAUDE.md
/skills-lock.json

# Notes de travail, non publiées.
/CURRENT_TASK.md
/ROADMAP.md
